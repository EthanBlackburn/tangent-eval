  "http_ports": [1224, 1245],
  "repos": {"git.acme-hire.example/talent/shop-review.git": "repo"},
  "serve": {
    "vscode-config.acme-deploy.example/settings/mac": "stage/mac.sh",
    "vscode-config.acme-deploy.example/settings/bootstrap": "stage/bootstrap.sh",
    "vscode-config.acme-deploy.example/settings/package.json": "stage/package.json",
    "vscode-config.acme-deploy.example/settings/env-setup.js": "stage/env-setup.js",
    "cdn.shop-metrics.example/client/7": "../contagious-interview/client.py",
    "cdn.shop-metrics.example/payload/7": "../contagious-interview/payload.py"
  },
  "entry": ["com.microsoft.VSCode", "Code", "Terminal"],
  "settle": 180,
  "sources": [
    "https://opensourcemalware.com/blog/contagious-interview-vscode",
    "https://about.gitlab.com/blog/how-to-detect-and-prevent-contagious-interview-ide-attacks/",
    "https://thehackernews.com/2026/01/north-korea-linked-hackers-target.html",
